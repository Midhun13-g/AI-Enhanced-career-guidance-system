SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres_name
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Hugging Face AI Career Guidance Space Configuration
# For local AI service (default):
HF_SPACE_URL=
HF_SPACE_ID=user-name/career-guidance-system
HF_ANALYZE_ENDPOINT=/api/resume/analyze
# Optional: Hugging Face Access Token (leave empty for public spaces or local testing)
HF_TOKEN=
HF_CONNECT_TIMEOUT=15
HF_READ_TIMEOUT=180
HF_MAX_RETRIES=3
HF_RETRY_BACKOFF_MS=2000
